# Supabase Configuration
# Copy this file to .env.local and fill in your values

# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-only) - used for generation tracking. NE JAMAIS exposer cote client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sel serveur pour le hash SHA-256 des IP (rate limit sur /api/analyze). NE JAMAIS exposer cote client.
# Generer une valeur aleatoire, ex: openssl rand -hex 32
IP_HASH_SALT=your-random-salt-value
